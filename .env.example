# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Юзернейм бота без @
BOT_USERNAME=Districtt13bot
# Короткое имя Mini App из /newapp (для ссылок t.me/bot/app?startapp=...). Можно оставить пустым.
APP_SHORT_NAME=clips
# Публичный HTTPS-адрес, где открыт фронтенд (этот же сервер)
WEBAPP_URL=https://clips-tg.onrender.com
# Telegram ID админов через запятую (для /delete, /stats)
ADMIN_IDS=643246726
# Путь к базе
DB_URL=sqlite+aiosqlite:///./clips.db
# 1 = режим разработки: можно открыть в обычном браузере без Telegram
DEV_MODE=0
HOST=0.0.0.0
PORT=8080
# Секрет для webhook-режима (любая длинная строка из букв/цифр). Пусто = long polling
WEBHOOK_SECRET=
# Лимит getFile Bot API — 20 МБ
MAX_VIDEO_BYTES=20971520
# Максимальная длина ролика в секундах
MAX_DURATION_SEC=90
